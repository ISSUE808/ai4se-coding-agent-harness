{
  "name": "codeharness-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "dev": "tsc && electron .",
    "dist": "node prepare-resources.mjs && npm run build && electron-builder"
  },
  "build": {
    "appId": "com.codeharness.desktop",
    "productName": "CodeHarness",
    "directories": {
      "output": "build"
    },
    "files": ["dist/**"],
    "extraResources": [
      { "from": "backend-pack", "to": "backend" }
    ],
    "win": { "target": ["nsis", "portable"], "signAndEditExecutable": false },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
